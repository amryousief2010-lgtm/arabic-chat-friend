    "tools": [
      {
        "name": "system_map",
        "title": "System map",
        "description": "خريطة النظام: الأقسام ووظائفها ومصادر البيانات (جداول/عروض) والعلاقات بينها وقواعد العمل والمؤشرات. ابدأ بهذه الأداة لفهم النظام قبل الاستعلام.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "section": {
              "type": "string",
              "description": "اختياري: اسم قسم لعرض تفاصيله فقط، مثل inventory أو sales_orders."
            },
            "include_datasets": {
              "type": "boolean",
              "description": "تضمين قائمة مصادر البيانات لكل قسم (افتراضي true)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_datasets",
        "title": "List datasets",
        "description": "استعراض مصادر البيانات المتاحة للقراءة (جداول وعروض) مع القسم والأعمدة والعلاقات. استخدمها لمعرفة أسماء الأعمدة قبل استدعاء query_dataset.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "section": {
              "type": "string",
              "description": "تصفية بالقسم، مثل inventory أو finance."
            },
            "search": {
              "type": "string",
              "description": "بحث نصي في اسم المصدر أو أعمدته."
            },
            "include_columns": {
              "type": "boolean",
              "description": "تضمين أسماء الأعمدة (افتراضي true)."
            },
            "limit": {
              "type": "number",
              "description": "عدد النتائج (افتراضي 100، أقصى 400)."
            },
            "offset": {
              "type": "number",
              "description": "بداية الترقيم (افتراضي 0)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "query_dataset",
        "title": "Query dataset",
        "description": "استعلام عام للقراءة من أي مصدر بيانات في النظام (جدول أو عرض) مع فلاتر وترتيب وترقيم صفحات وعدد إجمالي دقيق. القراءة تتم بصلاحيات المستخدم الموقّع فقط. استخدم list_datasets لمعرفة الأعمدة.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "string",
              "description": "اسم الجدول أو العرض، مثل orders أو inventory_movements."
            },
            "select": {
              "type": "string",
              "description": "أعمدة مفصولة بفواصل (افتراضي كل الأعمدة)."
            },
            "filters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "column": {
                    "type": "string",
                    "description": "اسم العمود."
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "eq",
                      "neq",
                      "gt",
                      "gte",
                      "lt",
                      "lte",
                      "like",
                      "ilike",
                      "in",
                      "is_null",
                      "not_null"
                    ],
                    "description": "المُعامل: eq, neq, gt, gte, lt, lte, like, ilike, in, is_null, not_null."
                  },
                  "value": {
                    "type": "string",
                    "description": "القيمة؛ لـ in افصل بفواصل. غير مطلوبة مع is_null/not_null."
                  }
                },
                "required": [
                  "column",
                  "op"
                ],
                "additionalProperties": false
              },
              "description": "قائمة الفلاتر."
            },
            "search": {
              "type": "string",
              "description": "بحث نصي (ilike) في العمود المحدد في search_column."
            },
            "search_column": {
              "type": "string",
              "description": "العمود المستخدم مع search."
            },
            "order_by": {
              "type": "string",
              "description": "عمود الترتيب (افتراضي created_at إن وُجد)."
            },
            "ascending": {
              "type": "boolean",
              "description": "ترتيب تصاعدي (افتراضي false)."
            },
            "page": {
              "type": "number",
              "description": "رقم الصفحة يبدأ من 1."
            },
            "page_size": {
              "type": "number",
              "description": "حجم الصفحة (افتراضي 50، أقصى 500)."
            }
          },
          "required": [
            "dataset"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_record",
        "title": "Get record details",
        "description": "قراءة سجل واحد من أي مصدر بيانات بالمعرّف (أو بعمود آخر)، مع تحميل السجلات المرتبطة به من الجداول الأبناء (البنود، الحركات، المرفقات، سجل التعديلات).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "dataset": {
              "type": "string",
              "description": "اسم الجدول، مثل orders أو meat_factory_batches."
            },
            "id": {
              "type": "string",
              "description": "قيمة المعرّف."
            },
            "id_column": {
              "type": "string",
              "description": "عمود المعرّف (افتراضي id)."
            },
            "include_related": {
              "type": "boolean",
              "description": "تحميل السجلات المرتبطة (افتراضي true)."
            },
            "related_limit": {
              "type": "number",
              "description": "عدد السجلات المرتبطة لكل جدول (افتراضي 50، أقصى 200)."
            }
          },
          "required": [
            "dataset",
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
